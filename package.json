{
  "name": "flowboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run scan && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "scan": "node scripts/scan-forbidden.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run --coverage",
    "build": "npm run build --workspace @flowboard/web && npm run build --workspace @flowboard/api",
    "dev": "concurrently -k -n api,web \"npm:dev --workspace @flowboard/api\" \"npm:dev --workspace @flowboard/web\"",
    "db:migrate": "npm run db:migrate --workspace @flowboard/api",
    "db:seed": "npm run db:seed --workspace @flowboard/api",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.34.0",
    "vitest": "^5.1.1"
  }
}
