# Image release tag: latest, v1.2.3, or sha-<short-commit>
FLOWBOARD_VERSION=latest

# Host ports. Put TLS and domain routing in a reverse proxy.
WEB_PORT=3000
API_PORT=4000

# PostgreSQL credentials (hex secrets are URL-safe for DATABASE_URL).
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
POSTGRES_DB=flowboard

# API signing secrets: generate each independently with `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-random-hex-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-hex-secret

# Exact public browser origin, without a trailing slash.
WEB_ORIGIN=https://flowboard.example.com

# Container-internal API origin used only by the web server-side proxy.
API_ORIGIN=http://api:4000

# API public origin used by browser WebSockets. The client upgrades https -> wss.
# For local testing, use http://localhost:4000.
WS_PUBLIC_URL=https://api.example.com

# Demo account seed password; set a unique value for any shared deployment.
DEMO_PASSWORD=replace-with-a-strong-demo-password

# Seed runs on startup by default. Set false to disable demo data seeding.
RUN_SEED=true
